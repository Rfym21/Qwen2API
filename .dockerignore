# Only send inputs used by the Docker build stages.
**
!package.json
!bun.lock
!src/
!src/**
!public/
!public/**
!tools/
!tools/build-binary.mjs
!tools/binary-entry.mjs
!tools/binary-frontend.mjs
!pkg_dist/
!pkg_dist/docker/
!pkg_dist/docker/**

# Do not import host dependencies, generated output, or local settings.
**/node_modules
**/dist
**/dist-ssr
**/.env
**/.env.*
**/.npm
**/.bun
**/.cache
**/.tmp
**/.temp
**/coverage
**/*.log
**/*.local
**/.git
**/.gitignore
**/.vscode
**/.idea
**/.DS_Store
**/Thumbs.db
